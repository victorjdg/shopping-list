# Servidor MCP de la lista de la compra (5 tools sobre db/db.py: add_item,
# remove_item, update_price, query_cheapest, list_current), pensado para conectarse
# como "Connector" desde Mistral AI. Mismo patrón que podman/mcp-server del repo
# Server: FastMCP + Streamable HTTP en /mcp + Bearer token. La imagen se construye
# en local a partir de ./mcp (Dockerfile propio, no hay imagen publicada en ningún
# registro).

CONTAINER_NAME=shopping-list
IMAGE_NAME=shopping-list:latest

# Solo en loopback a propósito, no en toda la LAN -- Caddy corre en --network host
# y llega igualmente por 127.0.0.1 (ver Caddyfile del repo Server), así este
# servicio queda protegido detrás de su autenticación (MCP_AUTH_TOKEN) sin quedar
# accesible directo desde la red local. 8001 en el host porque el 8000 ya lo usa
# mcp-server; dentro del contenedor siempre escucha en 8000.
PORT=8001

# Volumen appdata propio donde vive el fichero SQLite (mismo convenio que el resto
# de servicios). Se monta en /appdata dentro del contenedor.
APPDATA_ROOT=/mnt/storage/appdata/shopping-list

# Ruta del fichero SQLite DENTRO del contenedor (sobre el volumen de arriba). Se
# pasa como env al contenedor; sin tocar db/, que por defecto lo pondría junto al
# código (se pierde al reconstruir el contenedor).
SHOPPING_LIST_DB=/appdata/shopping_list.sqlite

# Deployment del worker de Mistral Workflows que registra el workflow "shopping-receipt"
# (~/mistral-workflow-project en el servidor, ver Server/podman/mistral-workflow/) -- la
# tool process_receipt_photo dispara la ejecución contra este deployment concreto, no
# contra "default". Debe coincidir con DEPLOYMENT_NAME del .env de ese proyecto.
WORKFLOWS_DEPLOYMENT_NAME=vserver-mistral-workflow-project-kind-robin
