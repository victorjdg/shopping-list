# Shopping-list MCP server (5 tools over db/db.py: add_item, remove_item, update_price,
# query_cheapest, list_current), meant to be connected as a "Connector" from Mistral AI.
# FastMCP + Streamable HTTP on /mcp + Bearer token. The image is built locally from
# ./mcp (own Dockerfile, no image published to any registry).

CONTAINER_NAME=shopping-list
IMAGE_NAME=shopping-list:latest

# Loopback only on purpose, not on the whole LAN -- a reverse proxy in front (e.g. Caddy
# with --network host) reaches it just the same over 127.0.0.1, so this service stays
# protected behind its own auth (MCP_AUTH_TOKEN) without being directly accessible from
# the local network. Adjust the port if you already have another service on 8001.
PORT=8001

# Own appdata volume where the SQLite file lives (same convention as any other
# service). Mounted at /appdata inside the container.
APPDATA_ROOT=/mnt/storage/appdata/shopping-list

# SQLite file path INSIDE the container (on top of the volume above). Passed as an env
# var to the container; without touching db/, which by default would put it next to the
# code (lost on every container rebuild).
SHOPPING_LIST_DB=/appdata/shopping_list.sqlite

# Deployment of the Mistral Workflows worker that registers the "shopping-receipt"
# workflow (see workflow/README.md) -- the process_receipt_photo tool triggers
# execution against this specific deployment, not "default". Must match the deployment
# name configured on that worker.
WORKFLOWS_DEPLOYMENT_NAME=vserver-mistral-workflow-project-kind-robin
