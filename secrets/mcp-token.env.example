# Copy as "mcp-token.env" (without .example) and fill in a long random token -- this is
# the secret that Mistral AI must send as the Connector's credential to use this MCP
# server. Generate one with:
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48
MCP_AUTH_TOKEN=PUT_A_LONG_RANDOM_TOKEN_HERE

# Mistral API key (console.mistral.ai) -- needed so the process_receipt_photo tool can
# trigger the "shopping-receipt" Workflow. Must be the same account/project as the
# worker that registers that workflow (see workflow/README.md).
MISTRAL_API_KEY=PUT_YOUR_MISTRAL_API_KEY_HERE
