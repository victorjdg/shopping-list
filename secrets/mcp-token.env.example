# Copia como "mcp-token.env" (sin .example) y rellena con un token aleatorio largo -- es el
# secreto que Mistral AI debe enviar como credencial del Connector para poder usar este
# servidor MCP. Generar uno con:
#   tr -dc 'A-Za-z0-9' < /dev/urandom | head -c 48
MCP_AUTH_TOKEN=PON_AQUI_UN_TOKEN_ALEATORIO_LARGO
